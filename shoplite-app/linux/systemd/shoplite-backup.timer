# Starts shoplite-backup.service every night at 02:00 server time (question 3.3).
# Installed in /etc/systemd/system/; enable with: sudo systemctl enable --now shoplite-backup.timer
[Unit]
Description=Nightly ShopLite database backup

[Timer]
OnCalendar=*-*-* 02:00:00

[Install]
WantedBy=timers.target
