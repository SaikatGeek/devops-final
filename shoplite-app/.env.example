# Copy to .env for local Docker Compose runs: cp .env.example .env
# These values are for the local stack only. Real credentials never go in Git.

# PostgreSQL
POSTGRES_DB=shoplite
POSTGRES_USER=shoplite
POSTGRES_PASSWORD=local-dev-only-change-me

# Tracing (optional). Uncomment, then `docker compose --profile tracing up -d`
# and open the Jaeger UI at http://127.0.0.1:16686. Empty = spans are not exported.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# Fault injection (question 1.5, used in Q8). All off by default; uncomment one to test.
# catalog-api: delay in ms added to about 30% of GET /products/{id}
# CHAOS_LATENCY_MS=800
# catalog-api: fraction of POST /orders answered with HTTP 500 (0.1 = 10%)
# CHAOS_ERROR_RATE=0.1
# order-worker: keep about 1 MB per processed order, never freed
# CHAOS_MEMORY_LEAK=true
# order-worker: run SELECT pg_sleep(2) before each database update
# CHAOS_SLOW_DB=true
