# ShopLite web: the static page, plus a proxy from /api/ to catalog-api.
#
# The image's entrypoint renders this template into /etc/nginx/conf.d/default.conf
# when the container starts, filling in two environment variables:
#   API_UPSTREAM           host:port of catalog-api (image default: catalog-api:8000)
#   NGINX_LOCAL_RESOLVERS  DNS servers from /etc/resolv.conf: Docker's 127.0.0.11 or
#                          kube-dns. Set because the image has NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1.
# nginx's own variables ($status, $uri, ...) stay as they are: the entrypoint only
# replaces variables that exist in the environment.

# One JSON object per line, with the same core fields as the Python services, so Loki
# parses every ShopLite service the same way. nginx has no trace, so trace_id is null.
map $status $shoplite_log_level {
    ~^5     ERROR;
    ~^4     WARNING;
    default INFO;
}

log_format shoplite_json escape=json
    '{"timestamp":"$time_iso8601","level":"$shoplite_log_level","service":"web",'
    '"message":"request completed","trace_id":null,"method":"$request_method",'
    '"path":"$request_uri","status":$status,"duration_s":$request_time}';

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;
    access_log /dev/stdout shoplite_json;

    # Names in proxy_pass below are looked up through this resolver at request time.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # Liveness for Docker's HEALTHCHECK and the Kubernetes probes. Not logged, like
    # the API's probe endpoints.
    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    # The page. no-cache makes the browser revalidate on every load, so a new
    # deployment (the Q7 checkpoint changes the <title>) shows up on the next reload.
    location / {
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ =404;
    }

    # /api/products?x=1 -> http://catalog-api:8000/products?x=1 (prefix removed, query kept).
    # With a variable in proxy_pass, nginx resolves the name per request instead of at
    # start, so nginx starts even when catalog-api does not exist yet (502 until it does).
    location /api/ {
        set $api_upstream http://${API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
