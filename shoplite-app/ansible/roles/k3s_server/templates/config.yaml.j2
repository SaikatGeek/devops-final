# Managed by Ansible (role k3s_server). Read by `k3s server` at start.
write-kubeconfig-mode: "0600"
cluster-cidr: {{ k3s_pod_cidr }}
service-cidr: {{ k3s_service_cidr }}
disable:
{% for component in k3s_server_disable %}
  - {{ component }}
{% endfor %}
{% if k3s_server_tls_sans %}
tls-san:
{% for name in k3s_server_tls_sans %}
  - {{ name }}
{% endfor %}
{% endif %}
# kubelet pulls ECR images with the node's IAM role (installed by role container_runtime).
image-credential-provider-bin-dir: {{ k3s_credential_provider_dir }}/bin
image-credential-provider-config: {{ k3s_credential_provider_dir }}/config.yaml
{% if k3s_kubelet_args %}
kubelet-arg:
{% for arg in k3s_kubelet_args %}
  - {{ arg }}
{% endfor %}
{% endif %}
