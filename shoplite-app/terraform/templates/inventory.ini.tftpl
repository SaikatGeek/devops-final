# Ansible inventory of this lab session, generated by Terraform (output ansible_inventory).
# Addresses change with every apply, so write it again after each one, from shoplite-app/:
#   terraform -chdir=terraform output -raw ansible_inventory > ansible/lab.ini
#
# The nodes have no public IP. Ansible's SSH goes through the bastion host (the lab's
# organization policy denies SSM to the instances): the ProxyCommand logs in to the bastion
# with the same key and opens a channel to port 22 of the node in ansible_host.

[control_plane]
control-plane ansible_host=${control_plane_ip}

[workers]
%{ for i, ip in worker_ips ~}
worker-${i + 1} ansible_host=${ip}
%{ endfor ~}

[k3s_cluster:children]
control_plane
workers

[k3s_cluster:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=${ssh_private_key_file}
ansible_ssh_common_args=-o ProxyCommand="${proxy_command}"
