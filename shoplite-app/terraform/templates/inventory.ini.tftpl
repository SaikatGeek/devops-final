# Ansible inventory of this lab session, generated by Terraform (output ansible_inventory).
# Instance ids change with every apply, so write it again after each one, from shoplite-app/:
#   terraform -chdir=terraform output -raw ansible_inventory > ansible/lab.ini
#
# The nodes have no public IP and no open port 22. Ansible's SSH goes through SSM Session
# Manager: the ProxyCommand opens an SSM session (AWS-StartSSHSession) to port 22 of the
# instance named in ansible_host. Needs the AWS CLI with the Session Manager plugin.

[control_plane]
control-plane ansible_host=${control_plane_id}

[workers]
%{ for i, id in worker_ids ~}
worker-${i + 1} ansible_host=${id}
%{ endfor ~}

[k3s_cluster:children]
control_plane
workers

[k3s_cluster:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=${ssh_private_key_file}
ansible_ssh_common_args=-o ProxyCommand="aws ssm start-session --region ${region} --target %h --document-name AWS-StartSSHSession --parameters portNumber=%p"
