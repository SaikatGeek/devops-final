# Local secrets: copy .env.example to .env; never commit .env
.env
*.env.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Kubernetes / cloud credentials
kubeconfig*
*.kubeconfig
# ...but not the Ansible role that fetches the kubeconfig (code, no credentials)
!/ansible/roles/kubeconfig/
*.pem
*.key

# The lab's Ansible inventory, written from `terraform output -raw ansible_inventory`;
# its instance ids change with every lab session.
/ansible/lab.ini

# Helm
helm/**/charts/*.tgz

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
